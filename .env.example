# ---------------------------------------------------------------------------
# Tavryc — internal operating system. Environment template.
# Copy to .env and fill in. NEVER commit a real .env.
# Values below are safe placeholders, not real secrets.
#
# Deployment target: PythonAnywhere free tier (100 CPU-seconds/day, 512 MiB
# disk). Keep the SQLite database, the .env file and the uploads directory
# inside the home directory so a single backup captures everything.
# ---------------------------------------------------------------------------

# Flask
FLASK_ENV=development
FLASK_APP=wsgi:app
SECRET_KEY=replace-me-with-a-long-random-string-at-least-32-chars

# Database
# PythonAnywhere free tier has no MySQL for new accounts, so SQLite is the
# default. PostgreSQL remains supported for a paid host by changing this URI.
DATABASE_URL=sqlite:///instance/tavryc.sqlite
# Example PostgreSQL value:
# DATABASE_URL=postgresql+psycopg2://tavryc:CHANGE_ME@127.0.0.1:5432/tavryc

# Session cookie security. Set COOKIE_SECURE=true only when serving over HTTPS.
# PythonAnywhere serves https://<user>.pythonanywhere.com, so set true there.
COOKIE_SECURE=false
SESSION_LIFETIME_HOURS=8

# Company defaults (overridable later in the Settings UI by the CEO)
COMPANY_NAME=Tavryc
COMPANY_TZ=Asia/Karachi

# Uploads — must live OUTSIDE the static directory.
# On PythonAnywhere use an absolute path, e.g. /home/<user>/tavryc-uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
MAX_FILES_PER_SUBMISSION=3

# Optional SMTP. The application runs fully without it; in development the
# password-reset and invitation links are written to the server log instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
MAIL_FROM=no-reply@tavryc.com

# Token lifetimes, in minutes
INVITE_TOKEN_TTL_MINUTES=2880
RESET_TOKEN_TTL_MINUTES=60

# Anonymous suggestions require BOTH the setting row and this salt to be set.
ANON_VOTE_SALT=replace-me-with-a-random-salt

# Reverse proxy / deployment
PROXY_FIX_ENABLED=false
TRUSTED_PROXY_COUNT=1

# Set true only behind TLS in production. Enables HSTS + secure cookies.
FORCE_HTTPS=false

# Set true when running on the PythonAnywhere free tier so the app keeps
# request-time work small and disables optional background jobs.
PYTHONANYWHERE_FREE_TIER=false
