# ---------------------------------------------------------------------------
# XYZ Ltd. Internal Operating System — environment template.
# Copy to .env and fill in. NEVER commit a real .env.
# Values below are safe placeholders, not real secrets.
# ---------------------------------------------------------------------------

# Flask
FLASK_ENV=development
FLASK_APP=wsgi:app
SECRET_KEY=replace-me-with-a-long-random-string-at-least-32-chars

# Database
# Dev/test default is SQLite under instance/. Production uses PostgreSQL.
DATABASE_URL=sqlite:///instance/xyz_os_dev.sqlite
# Example production value:
# DATABASE_URL=postgresql+psycopg2://xyzos:CHANGE_ME@127.0.0.1:5432/xyzos

# Session cookie security. Set COOKIE_SECURE=true only when serving over HTTPS.
COOKIE_SECURE=false
SESSION_LIFETIME_HOURS=8

# Company defaults (overridable later in Settings UI by the CEO)
COMPANY_TZ=Asia/Karachi
COMPANY_NAME=XYZ Ltd.

# Uploads — must live OUTSIDE the static directory
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10
MAX_FILES_PER_SUBMISSION=5

# Optional SMTP. The application runs fully without it; in development the
# password-reset and invitation links are written to the server log instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
MAIL_FROM=no-reply@xyz.example
# When true and SMTP is unset, links are still logged but a warning is shown.
ALLOW_INSECURE_DEV_LINKS=true

# Anonymous suggestions require BOTH the setting row and this salt to be set.
ANON_VOTE_SALT=replace-me-with-a-random-salt

# Reverse proxy / deployment
PROXY_FIX_ENABLED=false
TRUSTED_PROXY_COUNT=1

# Set true only behind TLS in production. Enables HSTS + secure cookies.
FORCE_HTTPS=false
